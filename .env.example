# Sao chep file nay thanh .env roi dien gia tri that. KHONG commit file .env.

# --- Gemini ---
#
# DOC TRUOC KHI DIEN KHOA NAY: moi luot chat gui du lieu RA KHOI he thong, sang may chu
# cua Google.
#   - Nhung gi nguoi dung tu go: LUON duoc gui di.
#   - Ho so be: CHI duoc gui khi gia dinh so huu ho so da dong y qua
#     POST /api/v1/auth/dong-y-ai. Khi co dong y: ten be, thang tuoi / can nang / che do an,
#     yeu to lam sang da chon, ket qua BITSS, loi dan cua bac si.
#   - KHONG BAO GIO gui: anh, email, mat khau, ghi chu tu do cua ho so, ten bac si, ho ten
#     nguoi hoi.
# Noi dung thong bao cho nguoi dung: GET /api/v1/chat/thong-bao-du-lieu. Muc 24 trong
# tests/verify_task.py doi chieu thong bao do voi payload that, nen hai thu khong the lech nhau.
#
# Viec con lai o muc du an, khong phai o muc code: doi chieu dieu khoan xu ly du lieu cua
# goi Gemini dang dung voi yeu cau luu tru du lieu y te cua noi trien khai - nhat la cau
# du lieu gui len co bi dung de cai thien san pham hay khong (thuong khac nhau giua ban
# mien phi va ban tra phi).
#
# De TRONG bien nay la cach tat o chat mot cach chu dong: POST /api/v1/chat tra 503 kem
# thong bao "tro ly AI chua duoc bat", con toan bo phan con lai cua he thong van chay.
GEMINI_API_KEY=

# De TRONG de dung mac dinh da ghim trong agent_service.py. Chi dien khi muon doi
# co chu y. Canh bao: gemini-1.5-flash (gia tri cu cua file nay) da bi go han, va
# models.list() van liet ke ca nhung model goi toi la 404 - danh sach model KHONG
# phai danh sach model minh goi duoc, chi mot lan goi that moi biet.
# GEMINI_MODEL=

# Model rieng cho danh_gia/eval_agent.py. Nen KHAC model phuc vu that: han muc mien phi tinh
# theo ngay tren TUNG model (do that: 20 request/ngay cho gemini-3.6-flash), nen mot
# lan chay bo danh gia se nuot sach phan danh cho nguoi dung.
# GEMINI_EVAL_MODEL=

# --- Tuy chon: gioi han vong goi cong cu va thu lai ---
# So vong goi cong cu toi da trong MOT luot hoi.
# GEMINI_MAX_TOOL_ROUNDS=5
# So LOI GOI cong cu toi da trong mot luot. Khac voi so VONG o tren: mot response co the
# chua nhieu function_calls cung luc, nen chan so vong KHONG gioi han khoi luong viec.
# GEMINI_MAX_TOOL_CALLS=12
# So lan GOI API toi da cho mot vong (1 lan dau + cac lan thu lai).
# GEMINI_RETRY_ATTEMPTS=3
# GEMINI_RETRY_BASE_DELAY=1.0
# Han chot theo dong ho treo tuong cho TOAN BO mot luot hoi (giay), tinh ca do tre
# cua API chu khong chi thoi gian ngoi cho giua cac lan thu lai.
# GEMINI_RETRY_BUDGET=60

# --- Khoa ky JWT ---
# Sinh khoa moi:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Toi thieu 32 ky tu. Doi khoa nay se vo hieu hoa TOAN BO token dang luu hanh
# (moi nguoi dung phai dang nhap lai) - dung dung de xoay vong dinh ky ma khong bao truoc.
JWT_SECRET_KEY=

# --- Bi mat dung chung cho worker suy luan ---
# Worker CNN dinh kem header  X-Service-Token: <gia tri nay>  khi ghi ket qua.
# Sinh:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# De TRONG dong nghia CAM tat ca: cac endpoint inference-* se tu choi moi request.
# Day la lua chon co chu y - thieu cau hinh phai la dong cua, khong phai mo toang.
INFERENCE_SERVICE_TOKEN=

# --- Origin duoc phep goi API (CORS) ---
# Danh sach ngan cach bang dau phay. De TRONG thi dung mac dinh la cac cong localhost
# quen thuoc cua frontend dev (3000/5173) - du de chay may, khong du de trien khai that.
#
# KHONG dat "*". Ung dung se tu choi khoi dong neu gap gia tri do, va day la co y:
# "*" di kem allow_credentials khong lam Starlette tra ve "*", ma khien no DOI CHIEU
# origin cua nguoi goi ve kem Access-Control-Allow-Credentials: true - tuc la moi trang
# web deu doc duoc response. Cau hinh cu cua du an nay dung "*" va dinh dung loi do.
# CORS_ALLOW_ORIGINS=https://app.benhvien.vn,https://admin.benhvien.vn

# --- Han muc goi ---
# Dang: RATE_<NHOM>_ANON / _USER / _WINDOW. Chi co BON nhom, va viec danh sach nay ngan la
# co chu y - dat han muc len moi endpoint la nghi thuc bao mat chu khong nham vao moi de
# doa nao co that. Cac endpoint GET deu da xac thuc, phan trang chan o 100, truy van co
# index. Cac endpoint inference-* la worker CUA CHINH MINH: dat han muc len no la tu bop
# nghet hang doi xu ly.
#
# Trang thai nam TRONG TIEN TRINH: chay nhieu worker thi moi worker mot so, nen han muc
# thuc te nhan len theo so worker. Khoi dong lai la mat so.

# chat: endpoint duy nhat vua khong can dang nhap vua ton tien that moi lan goi.
# RATE_CHAT_ANON=6
# RATE_CHAT_USER=20
# RATE_CHAT_WINDOW=600

# dang_ky: do that 208ms bcrypt moi lan goi, khong can dang nhap. Van de khong nam o so
# request/giay ma o CHIEM DUNG LUONG - 40 ket noi lap la threadpool cua FastAPI day vinh
# vien. Cong them: tao tai khoan khong gioi han.
# RATE_DANG_KY_ANON=5

# dang_nhap: do mat khau khong gioi han (khong khoa tai khoan, khong dem lan sai), va sau
# khi va loi hash gia thi nhanh "email khong ton tai" cung ton 200ms that. Dem theo IP chu
# KHONG theo email dang thu: dem theo email se cho phep khoa chu tai khoan ra ngoai.
# RATE_DANG_NHAP_ANON=10

# upload: decode toi 40 trieu pixel (~120MB RAM) va ghi toi 10MB xuong dia moi lan goi,
# ma khong co han ngach dia o bat ky dau. Dem theo tai khoan.
# RATE_UPLOAD_USER=30

# Chan tren so khoa theo doi cung luc, de bang khong phinh vo han khi bi goi tu nhieu IP.
# RATE_MAX_KEYS=10000

# --- Trien khai sau proxy (nginx, Cloudflare, load balancer, mang Docker) ---
# DOC KY NEU KHONG CHAY UVICORN TRUC TIEP RA INTERNET.
#
# Han muc cho nguoi chua dang nhap (dang ky, dang nhap, chat an danh) dem theo IP. Uvicorn
# chi thay IP cua proxy bang IP that cua khach (lay tu X-Forwarded-For) khi request den tu
# mot IP nam trong FORWARDED_ALLOW_IPS - mac dinh chi 127.0.0.1 va ::1.
#   - nginx chay CUNG may, proxy_pass toi 127.0.0.1: khong can lam gi.
#   - Cloudflare, load balancer, nginx o may khac, container khac: PHAI khai IP cua proxy.
#     Quen buoc nay thi moi nguoi dung mang chung IP cua proxy, va CA TRANG chi con 10 lan
#     dang nhap moi 10 phut. Ung dung ghi canh bao vao log khi thay dau hieu nay.
#
# BAT BUOC dat bang bien moi truong THAT cua tien trinh, hoac co --forwarded-allow-ips.
# KHONG dat trong file .env: khi chay 'uvicorn main:app', uvicorn doc bien nay TRUOC khi nap
# ung dung, ma .env chi duoc nap khi ung dung duoc import - dong trong .env bi bo qua MA
# KHONG BAO GI. (Chay 'python main.py' thi lai co tac dung, vi thu tu nap nguoc lai - hai
# cach chay cho hai ket qua khac nhau, nen dung dua vao .env cho bien nay.)
#   uvicorn main:app --host 0.0.0.0 --forwarded-allow-ips="10.0.0.5"
# Tuyet doi khong dat "*" tru khi ung dung CHI nhan duoc request qua proxy: "*" nghia la tin
# X-Forwarded-For tu bat ky ai, va ke tan cong vuot moi han muc bang cach bia IP moi lan goi.
#
# Gioi han dung luong upload cung phai dat o proxy. Ung dung chi doc toi da 10 MB vao RAM,
# nhung Starlette da nhan tron than request va ghi tam xuong dia truoc do.
#   nginx:  client_max_body_size 11m;

# --- Xuat du lieu huan luyen (scripts/xuat_du_lieu_huan_luyen.py) ---
# Khoa tao ma benh nhan an danh (HMAC) cho tap du lieu gui sang phan mo hinh. Toi thieu 32
# ky tu. Thieu khoa thi script tu choi xuat - khong bao gio lui ve child_id that.
#
# GIU CO DINH SUOT DOI DU AN: cung mot be phai luon cung mot ma qua moi lan xuat, vi phan
# mo hinh chia train/test THEO BENH NHAN dua vao ma nay. Doi khoa la doi toan bo ma, va hai
# phien ban du lieu co the ro cung mot dua tre sang ca train lan test ma khong ai biet.
# CO Y la khoa rieng, khong dung lai JWT_SECRET_KEY: khoa JWT nen duoc xoay dinh ky.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# KHOA_MA_AN_DANH_DU_LIEU=
# Noi ghi nhat ky noi bo cua moi lan xuat (record_id nao da di ra). KHONG dat trong thu muc
# xuat hay bat ky cho nao se gui di. Doi thu muc thi nho mang theo nhat ky cu.
# THU_MUC_NHAT_KY_XUAT=data/nhat_ky_xuat

# --- Luu tru lich su tro chuyen ---
# Tin nhan cu hon so ngay nay bi XOA HAN khoi database (1..3650; gia tri sai thi ung dung
# tu choi khoi dong thay vi dung mot so khac). So nay cung duoc hien trong thong bao dong
# thuan, nen doi no la doi dieu da hua voi nguoi dung.
# CHAT_LUU_TRU_NGAY=90
# Khoang cach toi thieu (giay) giua hai lan don toan cuc do duong chat kich hoat. Server
# it nguoi dung co the chay them cron: python scripts/don_du_lieu_qua_han.py
# CHAT_DON_MOI_GIAY=3600

# --- Tuy chon ---
# Mac dinh moi du lieu chay that (database, anh tai len, nhat ky xuat) nam trong data/,
# thu muc khong bao gio duoc commit.
# DATABASE_URL=sqlite:///./data/bitss_clinic.db
# UPLOAD_DIR=data/uploads/raw
